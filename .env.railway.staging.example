# EFATÀ 777 — Railway STAGING / first integrated test
# Placeholder profile. Replace every <...> before deployment.
# Do NOT paste real secrets into chat.
# Railway-managed RAILWAY_* variables should NOT be manually overridden.

# -------------------------------------------------------------------
# CORE / RAILWAY
# -------------------------------------------------------------------
PLATFORM_ENVIRONMENT=staging
PLATFORM_RELEASE_SHA=<BACKEND_GIT_COMMIT_SHA_OR_RELEASE_SHA>
DATABASE_URL=<RAILWAY_POSTGRES_DATABASE_URL_REFERENCE>
PLATFORM_ALLOWED_ORIGINS=https://<FRONTEND_RAILWAY_DOMAIN>

# -------------------------------------------------------------------
# AUTH — recommended first staging profile: native_session
# -------------------------------------------------------------------
PLATFORM_AUTH_MODE=native_session
PLATFORM_DEMO_IDENTITY_HEADERS_ENABLED=false
PLATFORM_OWNER_SUBJECT=<OWNER_SUBJECT_OR_USER_ID>

PLATFORM_NATIVE_AUTH_PEPPER=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
PLATFORM_NATIVE_SESSION_SECRET=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
PLATFORM_NATIVE_BOOTSTRAP_SECRET=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>

PLATFORM_NATIVE_SESSION_COOKIE_NAME=__Host-patroai_session
PLATFORM_NATIVE_SESSION_COOKIE_SECURE=true
PLATFORM_NATIVE_SESSION_COOKIE_SAMESITE=lax
PLATFORM_NATIVE_SESSION_TTL_HOURS=12

PLATFORM_NATIVE_PASSWORD_MIN_LENGTH=12
PLATFORM_NATIVE_PASSWORD_RESET_TTL_MINUTES=30
PLATFORM_NATIVE_PASSWORD_RESET_BASE_URL=https://<FRONTEND_RAILWAY_DOMAIN>/reset-password

RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM=EFATA 777 <no-reply@<YOUR_VERIFIED_EMAIL_DOMAIN>>
PLATFORM_RESEND_USER_AGENT=efata777/1.0

PLATFORM_NATIVE_LOGIN_MAX_FAILURES=8
PLATFORM_NATIVE_LOGIN_LOCK_MINUTES=15

PLATFORM_INVITATION_TOKEN_SECRET=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
PLATFORM_INVITATION_TTL_HOURS=72
PLATFORM_INVITATION_BASE_URL=https://<FRONTEND_RAILWAY_DOMAIN>/invite

# Premium Platform User Invitation Plane — disabled until Wave B gate approval.
PLATFORM_USER_INVITATION_ENABLED=false
PLATFORM_USER_INVITATION_SECRET=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
PLATFORM_USER_INVITATION_TTL_HOURS=72
PLATFORM_USER_INVITATION_BASE_URL=https://<FRONTEND_RAILWAY_DOMAIN>/activate
PLATFORM_USER_INVITATION_ALLOWED_ROLES=member

PLATFORM_ADMIN_EMAIL_ALLOWLIST=<ADMIN_EMAIL_1>,<ADMIN_EMAIL_2>

# -------------------------------------------------------------------
# LLM / OPENAI
# -------------------------------------------------------------------
PLATFORM_LLM_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_DEFAULT_MODEL=gpt-5
PLATFORM_LLM_HTTP_TIMEOUT_SECONDS=30
PLATFORM_LLM_PROVIDER_FAILOVER_ENABLED=false
PLATFORM_LLM_AUTO_ROUTE_ENABLED=false
PLATFORM_INTERNAL_AGENT_CONSULTATION_ENABLED=false
PLATFORM_INTERNAL_AGENT_CONSULTATION_MAX=2

# -------------------------------------------------------------------
# REALTIME + VOICE INPUT
# -------------------------------------------------------------------
PLATFORM_REALTIME_STREAMING_ENABLED=true
PLATFORM_REALTIME_VOICE_ENABLED=true
PLATFORM_VOICE_PROVIDER=openai
PLATFORM_REALTIME_BRIDGE_ENABLED=true
PLATFORM_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# TTS intentionally deferred for first voice-to-text staging validation
PLATFORM_TTS_ENABLED=false
PLATFORM_TTS_PROVIDER=disabled
PLATFORM_VOICE_BINDINGS_JSON={}

# -------------------------------------------------------------------
# STT — local faster-whisper
# -------------------------------------------------------------------
PLATFORM_STT_ENABLED=true
PLATFORM_STT_PROVIDER=faster_whisper
PLATFORM_STT_MODEL=small
PLATFORM_STT_DEVICE=cpu
PLATFORM_STT_COMPUTE_TYPE=int8
PLATFORM_STT_MAX_UPLOAD_BYTES=8000000
PLATFORM_STT_ALLOWED_LANGUAGES=pt,en,es
PLATFORM_STT_MODEL_CACHE_DIR=/opt/orkio/models/faster-whisper
PLATFORM_STT_LOCAL_FILES_ONLY=false
PLATFORM_STT_TIMEOUT_SECONDS=60
PLATFORM_STT_CONCURRENCY_LIMIT=1

# -------------------------------------------------------------------
# NATAN / INTERNAL AUDITOR
# canonical backend agent_id = auditor
# -------------------------------------------------------------------
PLATFORM_AUDIT_GOVERNED_INVOCATION_ENABLED=true
PLATFORM_AUDIT_EVIDENCE_CAPABILITIES_ENABLED=true
PLATFORM_AUDIT_RUNTIME_INSPECT_ENABLED=true
PLATFORM_AUDIT_RUNTIME_FILE_SHA256_ENABLED=true
PLATFORM_AUDIT_RUNTIME_SEARCH_MARKER_ENABLED=true
PLATFORM_AUDIT_FILE_INSPECT_ENABLED=true
PLATFORM_AUDIT_ARCHIVE_INSPECT_ENABLED=true

PLATFORM_AUDIT_ALLOWED_AGENT_IDS=auditor
PLATFORM_AUDIT_ALLOWED_TENANT_IDS=<REAL_STAGING_TENANT_ID>
PLATFORM_AUDIT_ALLOWED_ENVIRONMENTS=staging

PLATFORM_AUDIT_TIMEOUT_SECONDS=3
PLATFORM_AUDIT_MAX_OUTPUT_BYTES=128000
PLATFORM_AUDIT_RATE_LIMIT_WINDOW_SECONDS=60
PLATFORM_AUDIT_USER_RATE_LIMIT_PER_WINDOW=4
PLATFORM_AUDIT_TENANT_RATE_LIMIT_PER_WINDOW=20
PLATFORM_AUDIT_DIRECTIVE_USER_RATE_LIMIT=12

ORKIO_AUDIT_TRACE_ENABLED=true

# -------------------------------------------------------------------
# KNOWLEDGE / DOCUMENT INTAKE
# -------------------------------------------------------------------
PLATFORM_KNOWLEDGE_PLANE_ENABLED=true
PLATFORM_KNOWLEDGE_CONTEXT_MAX_FILES=8
PLATFORM_KNOWLEDGE_CONTEXT_MAX_CHARS=60000
PLATFORM_KNOWLEDGE_CONTEXT_MAX_CHARS_PER_FILE=16000

PLATFORM_LARGE_DOCUMENT_PIPELINE_ENABLED=true
PLATFORM_KNOWLEDGE_MAX_UPLOAD_BYTES=524288000
PLATFORM_KNOWLEDGE_AUTO_PROCESS_BYTES=32000000
PLATFORM_KNOWLEDGE_MAX_PDF_PAGES=5000
PLATFORM_KNOWLEDGE_CHUNK_TARGET_CHARS=6000
PLATFORM_KNOWLEDGE_CHUNK_OVERLAP_CHARS=500
PLATFORM_KNOWLEDGE_RETRIEVAL_TOP_K=12
PLATFORM_KNOWLEDGE_SELECTIVE_CONTEXT_ENABLED=false

PLATFORM_UNIFIED_DOCUMENT_INTAKE_ENABLED=true
PLATFORM_DOCUMENT_INTAKE_LARGE_PASTE_THRESHOLD_CHARS=100000
PLATFORM_DOCUMENT_INTAKE_LARGE_PASTE_MAX_CHARS=5000000
PLATFORM_DOCUMENT_INTAKE_LARGE_PASTE_MAX_BYTES=20000000
PLATFORM_DOCUMENT_INTAKE_MANIFEST_MAX_BYTES=2000000

PLATFORM_DOCUMENT_CONTEXT_ENABLED=true
PLATFORM_DOCUMENT_CONTEXT_MAX_FILES=6
PLATFORM_DOCUMENT_CONTEXT_MAX_CHARS=48000
PLATFORM_DOCUMENT_CONTEXT_MAX_CHARS_PER_FILE=20000
PLATFORM_DOCUMENT_CONTEXT_MAX_PDF_PAGES=40
PLATFORM_DOCUMENT_INGESTION_MAX_ARCHIVE_ENTRIES=512
PLATFORM_DOCUMENT_INGESTION_MAX_TOTAL_UNCOMPRESSED_BYTES=64000000
PLATFORM_DOCUMENT_INGESTION_MAX_MEMBER_BYTES=16000000
PLATFORM_DOCUMENT_INGESTION_DOCX_MAX_XML_BYTES=2000000
PLATFORM_MAX_UPLOAD_BYTES=10000000

# -------------------------------------------------------------------
# ARTIFACT GENERATION
# STAGING ONLY: local storage is ephemeral unless you mount a Railway volume.
# Production requires durable S3-compatible storage in current backend validation.
# -------------------------------------------------------------------
PLATFORM_ARTIFACTS_ENABLED=true
PLATFORM_ARTIFACT_STORAGE_BACKEND=local
PLATFORM_ARTIFACT_STORAGE_PATH=/app/data/artifacts
PLATFORM_ARTIFACT_STORAGE_PREFIX=efata

# -------------------------------------------------------------------
# GITHUB / EXTERNAL READ — keep closed for first staging
# -------------------------------------------------------------------
PLATFORM_GITHUB_INTEGRATION_ENABLED=false
PLATFORM_GITHUB_READ_ONLY=true
PLATFORM_EXTERNAL_READ_ENABLED=false

# -------------------------------------------------------------------
# PYTHON RUNTIME / MODAL — DEFERRED, fail closed
# -------------------------------------------------------------------
PLATFORM_PYTHON_TOOL_ENABLED=false
PLATFORM_PYTHON_RUNTIME_MODE=disabled
PLATFORM_PYTHON_RUNTIME_ADAPTER=unconfigured
PLATFORM_PYTHON_RUNTIME_QUALIFIED=false
PLATFORM_PYTHON_LEGACY_LOCAL_TEST_ENABLED=false

# -------------------------------------------------------------------
# BILLING — DEFERRED, fail closed
# NOTE: current backend uses PLATFORM_BILLING_ENABLED.
# -------------------------------------------------------------------
PLATFORM_BILLING_ENABLED=false
PLATFORM_BILLING_LIVE_MODE_ENABLED=false
PLATFORM_BILLING_PROVIDER=disabled

# -------------------------------------------------------------------
# GOVERNED EVOLUTION — no autonomous writes/deploys
# -------------------------------------------------------------------
PLATFORM_ASSISTED_EVOLUTION_ENABLED=false
PLATFORM_EVOLUTION_EXECUTION_ALLOWED=false
PLATFORM_EVOLUTION_HUMAN_APPROVAL_REQUIRED=true

# -------------------------------------------------------------------
# ACCESS GATE — optional; leave disabled unless explicitly configuring it
# -------------------------------------------------------------------
PLATFORM_ACCESS_GATE_ENABLED=false
